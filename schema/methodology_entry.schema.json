{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "方法论知识条目结构模板",
  "type": "object",
  "required": [
    "entry_id", "title", "methodology", "topic",
    "summary", "steps", "applicable_scenarios",
    "cited_sources", "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "entry_id": {
      "type": "string",
      "pattern": "^method-[a-z0-9][a-z0-9-]{2,47}$",
      "description": "知识条目唯一 ID（method- 前缀，含数字方法论如 5W2H）"
    },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "methodology": {
      "type": "string",
      "minLength": 4,
      "maxLength": 300,
      "description": "方法论名称（如 Scrum / PDCA / 5W2H）"
    },
    "topic": { "type": "string", "minLength": 2, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 500 },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["order", "action"],
        "additionalProperties": false,
        "properties": {
          "order": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 3 }
        }
      }
    },
    "applicable_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "cited_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "reference", "excerpt"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 3 },
          "excerpt": { "type": "string", "minLength": 5 }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "检索标签（可选）"
    },
    "created_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"],
      "description": "条目状态，默认 draft"
    }
  }
}